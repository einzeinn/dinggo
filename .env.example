# Ollama Base REST API URL
OLLAMA_BASE_URL=http://localhost:11434

# Layer 1: Intent Parser Model (Gemma-SEA-LION)
MODEL_INTENT_PARSER=hf.co/aisingapore/Gemma-SEA-LION-v4.5-E2B-IT-GGUF:Q4_K_M

# Layer 2: Planner Model (Qwen3.5 4B)
MODEL_PLANNER=qwen3.5:4b

# Layer 3: Codegen Delegate Model (Qwen2.5 3B)
MODEL_CODEGEN=qwen2.5:3b

# Force unload previous model from memory when switching layers
FORCE_UNLOAD_BETWEEN_LAYERS=true

# Maximum retry attempts for malformed LLM JSON outputs
MAX_JSON_RETRY=3

# GPU Offload & CPU Thread Optimization
# Setting OLLAMA_NUM_GPU=99 instructs Ollama to offload all model layers to GPU/iGPU if driver supports it
OLLAMA_NUM_GPU=99

# Caps CPU threads during fallback/CPU execution to prevent spiking 100% CPU on all cores
OLLAMA_NUM_THREAD=4
