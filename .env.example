# Ollama Base REST API URL
OLLAMA_BASE_URL=http://localhost:11434

# Layer 1: Intent Parser Model (Gemma-SEA-LION)
MODEL_INTENT_PARSER=gemma-sea-lion

# Layer 2: Planner Model (Qwen3.5 4B)
MODEL_PLANNER=qwen3.5:4b

# Layer 3: Codegen Delegate Model (Qwen2.5-Coder 3B)
MODEL_CODEGEN=qwen2.5-coder:3b

# Force unload previous model from memory when switching layers
FORCE_UNLOAD_BETWEEN_LAYERS=true

# Maximum retry attempts for malformed LLM JSON outputs
MAX_JSON_RETRY=3
